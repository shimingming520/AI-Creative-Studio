# ============================================================
# AI-Creative-Studio / YUH-Studio 根 .gitignore
# 仓库根已重设为 YUH-Studio：本文件位于仓库根，规则均为根相对路径。
# 原则：源码/配置/资产跟踪；一切可再生的构建产物与第三方依赖不跟踪。
# ============================================================

# ---- 通用 ----
.DS_Store
Thumbs.db
*.log
*.tmp
*.bak
.idea/
.vscode/
*.iml

# ---- 工具 / 临时档（Playwright、CDP 等自动化日志与缓存） ----
.playwright-cli/
.tmp-cdp-*/

# ---- 临时工作标记 / 验证截图（分析会话的临时产物） ----
.s[0-9]*.txt
.snap*.txt
.after*.txt
.uploaded*.txt
.projectsnap*.txt
.verify*.png

# ---- Node ----
node_modules/
**/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ---- 环境变量 ----
.env
.env.*
!.env.example

# ============================================================
# Serpent 模块（内置；.vite 构建产物、平台二进制资源、构建目录）
# ============================================================
Serpent/.vite/
Serpent/dist/
Serpent/out/
Serpent/coverage/
Serpent/playwright-report/
Serpent/test-results/
Serpent/.media-build/
Serpent/.dolt/
Serpent/.beads/
Serpent/resources/ffmpeg/
Serpent/resources/oiio/
Serpent/resources/media-binaries/
build/serpent/

# ============================================================
# YUH-Studio 本体（打包输出、内置引擎/模型、反编译目录；现为仓库根）
# ============================================================
release/
bundled-resources/
app-full/
app-readable/
ui-build/
engine-source/node_modules/
engine-source/out/
engine-source/yunhui_tools/__pycache__/
